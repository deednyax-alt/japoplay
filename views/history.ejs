<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JapoPlay - Historique de Lecture</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav class="navbar scrolled">
    <div class="nav-left">
      <a href="/home" class="brand-logo">JAPO<span>PLAY</span></a>
      <ul class="nav-links">
        <li><a href="/home">Accueil</a></li>
        <li><a href="/movies">Films</a></li>
        <li><a href="/series">Séries</a></li>
        <li><a href="/anime">Animes</a></li>
        <li><a href="/iptv">Live TV</a></li>
        <li><a href="/history" class="active">Historique</a></li>
        <li><a href="/my-list">Ma Liste</a></li>
      </ul>
    </div>
    <div class="nav-right">
      <a href="/profiles" class="current-profile-btn">
        <img id="currentAvatar" src="" alt="Profile">
      </a>
    </div>
  </nav>

  <main style="padding: 110px 4% 40px 4%;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px;">
      <div>
        <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 6px;">Historique de Lecture</h1>
        <p style="color: var(--text-sub); font-size: 0.95rem;">Reprenez facilement la lecture de vos films, séries et animes vus récemment.</p>
      </div>
      <button class="btn-secondary" style="border-color: rgba(239, 68, 68, 0.4); color: #ef4444;" onclick="clearAllHistoryUi()">Effacer tout l'historique</button>
    </div>

    <div id="historyGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px;"></div>
  </main>

  <script src="/js/app.js"></script>
  <script>
    function renderHistoryUi() {
      const grid = document.getElementById('historyGrid');
      const history = getWatchHistory();

      if (!history || history.length === 0) {
        grid.innerHTML = `
          <div style="grid-column: 1/-1; text-align: center; color: var(--text-sub); padding: 60px 20px; background: rgba(255,255,255,0.02); border: 1px dashed var(--border-light); border-radius: 12px;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; opacity: 0.5;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <h3 style="color: #fff; font-size: 1.2rem; margin-bottom: 8px;">Aucun historique de lecture</h3>
            <p style="margin-bottom: 20px; font-size: 0.9rem;">Les titres que vous regardez apparaîtront ici automatiquement.</p>
            <a href="/home" class="btn-primary">Découvrir le catalogue</a>
          </div>
        `;
        return;
      }

      grid.innerHTML = history.map(item => {
        let watchUrl = `/watch?type=${item.type}&id=${item.id}&season=${item.season || 1}&episode=${item.episode || 1}`;
        let subText = item.type === 'movie' ? 'Film' : (item.type === 'iptv' ? 'Live TV' : `Saison ${item.season || 1} • Ép. ${item.episode || 1}`);
        let formattedDate = new Date(item.updatedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

        return `
          <div class="movie-card" style="background: #121216; border: 1px solid var(--border-light); border-radius: 10px; overflow: hidden; position: relative;">
            <div style="position: relative; aspect-ratio: 16/9; background: #000; overflow: hidden;">
              ${item.poster ? `<img src="${item.poster}" alt="${item.title}" style="width: 100%; height: 100%; object-fit: cover;">` : `<div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #1a1a20; color: #fff; font-weight: 700; padding: 12px; text-align: center;">${item.title}</div>`}
              <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.85) 100%);"></div>
              
              <a href="${watchUrl}" style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                <div style="width: 50px; height: 50px; border-radius: 50%; background: rgba(255,255,255,0.9); display: flex; align-items: center; justify-content: center; transform: scale(0.9); transition: transform 0.2s;">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="#000000" style="margin-left: 3px;"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </a>

              <button onclick="removeHistoryUiItem('${item.id}', '${item.type}', '${item.season}', '${item.episode}')" title="Supprimer" style="position: absolute; top: 8px; right: 8px; width: 30px; height: 30px; border-radius: 50%; background: rgba(0,0,0,0.7); border: 1px solid rgba(255,255,255,0.2); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>

              ${item.progressPct > 0 ? `
                <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: rgba(255,255,255,0.2);">
                  <div style="width: ${item.progressPct}%; height: 100%; background: #ffffff;"></div>
                </div>
              ` : ''}
            </div>

            <div style="padding: 14px;">
              <h3 style="font-size: 0.95rem; font-weight: 700; color: #fff; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.title}</h3>
              <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.78rem; color: var(--text-sub);">
                <span>${subText}</span>
                <span>${formattedDate}</span>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function removeHistoryUiItem(id, type, season, episode) {
      removeWatchHistoryItem(id, type, season, episode);
      renderHistoryUi();
    }

    function clearAllHistoryUi() {
      if (confirm('Voulez-vous vraiment effacer tout votre historique de lecture ?')) {
        clearWatchHistory();
        renderHistoryUi();
      }
    }

    document.addEventListener('DOMContentLoaded', renderHistoryUi);
  </script>

  <div class="mobile-bottom-nav">
    <a href="/home" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Accueil</span>
    </a>
    <a href="/movies" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>
      <span>Films</span>
    </a>
    <a href="/series" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
      <span>Séries</span>
    </a>
    <a href="/anime" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      <span>Animes</span>
    </a>
    <a href="/iptv" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.83a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/></svg>
      <span>Live TV</span>
    </a>
    <a href="/history" class="mobile-nav-item active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Historique</span>
    </a>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
