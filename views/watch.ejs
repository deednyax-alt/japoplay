<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JapoPlay Lecteur - <%= titleDisplay %></title>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
</head>
<%
  let backTarget = '/home';
  if (type === 'movie' && id) {
    backTarget = '/movie/' + id;
  } else if ((type === 'series' || type === 'anime') && id) {
    backTarget = '/series/' + id;
  }
%>
<body style="background: #000; overflow: hidden; margin: 0; padding: 0; width: 100vw; height: 100vh; user-select: none;">
  <div class="custom-player-root" id="playerRoot">
    <div class="player-container" id="playerBox">
      <% if (sources && sources.length > 0) { %>
        <% const src = sources[0]; %>
        <% if (src.type === 'video' || (src.url && (src.url.includes('.mp4') || src.url.includes('.m3u8')))) { %>
          <video id="videoElement" autoplay playsinline webkit-playsinline style="width: 100%; height: 100%; object-fit: contain;"></video>
        <% } else { %>
          <iframe id="iframeElement" src="/api/vstream/embed?url=<%= encodeURIComponent(src.url) %>" allowfullscreen allow="autoplay; fullscreen; encrypted-media" webkitallowfullscreen="true" mozallowfullscreen="true"></iframe>
        <% } %>
      <% } else { %>
        <div style="text-align: center; padding: 40px; color: var(--text-sub); max-width: 500px; z-index: 20;">
          <div style="width: 80px; height: 80px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px auto;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h2 style="color: #fff; font-size: 1.5rem; font-weight: 800; margin-bottom: 8px;">Aucun flux disponible</h2>
          <p style="margin-bottom: 24px; font-size: 0.95rem; line-height: 1.5;">Nos scrappers n'ont pas trouvé de source active pour ce titre.</p>
          <div style="display: flex; gap: 12px; justify-content: center;">
            <a href="<%= backTarget %>" class="btn-secondary">Retour</a>
            <a href="/home" class="btn-primary">Accueil</a>
          </div>
        </div>
      <% } %>
    </div>

    <div class="player-overlay-controls" id="overlayControls">
      <div class="top-bar">
        <a href="<%= backTarget %>" class="back-btn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          <span>Retour</span>
        </a>
        <div class="media-title"><%= titleDisplay %></div>
        <div style="display: flex; align-items: center; gap: 12px;">
          <% if (type === 'series' || type === 'anime') { %>
            <% const pEp = parseInt(episode) - 1; %>
            <% const nEp = parseInt(episode) + 1; %>
            <% if (pEp >= 1) { %>
              <a href="/watch?type=<%= type %>&id=<%= id %>&season=<%= season %>&episode=<%= pEp %>" class="btn-secondary" style="padding: 6px 14px; font-size: 0.8rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                Ép. Précédent
              </a>
            <% } %>
            <a href="/watch?type=<%= type %>&id=<%= id %>&season=<%= season %>&episode=<%= nEp %>" class="btn-primary" style="padding: 6px 14px; font-size: 0.8rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px;">
              Ép. Suivant
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          <% } %>
          <button onclick="manualUnfreeze()" class="btn-secondary" title="Relancer si la vidéo se fige" style="padding: 6px 12px; font-size: 0.8rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; background: rgba(88,101,242,0.3); color: #fff; border: 1px solid rgba(88,101,242,0.6);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span>⚡ Anti-Gel</span>
          </button>
          <button onclick="toggleFullscreen()" class="btn-secondary" title="Plein Écran (F)" style="padding: 6px 12px; font-size: 0.8rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.3);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <span>Plein Écran</span>
          </button>
          <div class="badge-hd">HD 1080P</div>
        </div>
      </div>

      <% if (sources && sources.length > 0) { %>
        <div class="center-play-trigger" onclick="togglePlayPause()">
          <svg id="centerPlayIcon" width="70" height="70" viewBox="0 0 24 24" fill="#ffffff"><path d="M8 5v14l11-7z"/></svg>
        </div>

        <div class="bottom-bar">
          <div class="progress-container" onclick="seekVideo(event)">
            <div class="progress-bar" id="progressBar"></div>
          </div>

          <div class="controls-row">
            <div class="left-ctrls">
              <button class="ctrl-btn" onclick="togglePlayPause()">
                <svg id="playBtnIcon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <button class="ctrl-btn" onclick="rewind(10)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 19l-9-7 9-7v14zM22 19l-9-7 9-7v14z"/></svg>
              </button>
              <button class="ctrl-btn" onclick="forward(10)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 5l9 7-9 7V5zM2 5l9 7-9 7V5z"/></svg>
              </button>

              <div class="volume-box">
                <button class="ctrl-btn" onclick="toggleMute()">
                  <svg id="volumeIcon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                </button>
                <input type="range" class="volume-slider" id="volumeSlider" min="0" max="1" step="0.05" value="1" oninput="changeVolume(this.value)">
              </div>

              <span class="time-display" id="timeDisplay">00:00 / 00:00</span>
            </div>

            <div class="right-ctrls">
              <% if (sources && sources.length > 1) { %>
                <select class="source-select" style="background:#121216; color:#fff;" onchange="switchSourceFromSelect(this.value)">
                  <% sources.forEach((s, idx) => { %>
                    <option value="<%= idx %>" style="background:#121216; color:#fff;"><%= s.name || ('Source ' + (idx + 1)) %></option>
                  <% }) %>
                </select>
              <% } %>

              <button class="ctrl-btn" onclick="toggleFullscreen()">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
              </button>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: #000;
    }
    .custom-player-root {
      width: 100vw;
      height: 100vh;
      background: #000;
      position: fixed;
      inset: 0;
    }
    .player-container {
      position: absolute;
      inset: 0;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
    }
    .player-container video,
    .player-container iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
      object-fit: contain;
      background: #000;
    }
    .custom-player-root.hide-cursor,
    .custom-player-root.hide-cursor * {
      cursor: none !important;
    }
    .player-overlay-controls {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 25%, rgba(0,0,0,0) 70%, rgba(0,0,0,0.9) 100%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px;
      opacity: 1;
      transition: opacity 0.3s ease;
      z-index: 10;
    }
    .player-overlay-controls.hide {
      opacity: 0;
      pointer-events: none;
    }
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .media-title {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.3px;
    }
    .badge-hd {
      background: #ffffff;
      color: #000000;
      font-size: 0.75rem;
      font-weight: 900;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .center-play-trigger {
      align-self: center;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.3);
      width: 90px;
      height: 90px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s, background 0.2s;
    }
    .center-play-trigger:hover {
      transform: scale(1.1);
      background: rgba(255, 255, 255, 0.25);
    }
    .bottom-bar {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .progress-container {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 4px;
      cursor: pointer;
      position: relative;
    }
    .progress-bar {
      height: 100%;
      width: 0%;
      background: #ffffff;
      border-radius: 4px;
      position: relative;
      box-shadow: 0 0 10px rgba(255,255,255,0.8);
    }
    .controls-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .left-ctrls, .right-ctrls {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .ctrl-btn {
      color: #ffffff;
      transition: transform 0.2s, color 0.2s;
    }
    .ctrl-btn:hover {
      transform: scale(1.15);
      color: #e4e4e7;
    }
    .volume-box {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .volume-slider {
      width: 80px;
      accent-color: #ffffff;
      cursor: pointer;
    }
    .time-display {
      font-size: 0.85rem;
      color: var(--text-sub);
      font-weight: 600;
    }
    .source-select {
      background: rgba(255,255,255,0.1);
      border: 1px solid var(--border-light);
      color: #fff;
      padding: 6px 12px;
      border-radius: 6px;
      outline: none;
    }
  </style>

  <script>
    const allSources = <%- JSON.stringify(sources || []) %>;
    let videoEl = null;
    let controlsTimeout = null;
    let savedPosition = 0;
    let lastHistorySave = 0;

    function formatTime(s) {
      if (isNaN(s) || !isFinite(s)) return '00:00';
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = Math.floor(s % 60);
      const pad = n => (n < 10 ? '0' + n : n);
      if (h > 0) {
        return `${pad(h)}:${pad(m)}:${pad(sec)}`;
      }
      return `${pad(m)}:${pad(sec)}`;
    }

    function checkResumePosition() {
      const history = getWatchHistory();
      const currentId = '<%= id || "" %>';
      const currentType = '<%= type || "movie" %>';
      const currentSeason = parseInt('<%= season || 1 %>');
      const currentEpisode = parseInt('<%= episode || 1 %>');

      const match = history.find(h => {
        if (currentType === 'movie' || currentType === 'iptv') {
          return h.id === currentId && h.type === currentType;
        }
        return h.id === currentId && h.type === currentType && parseInt(h.season) === currentSeason && parseInt(h.episode) === currentEpisode;
      });

      if (match && match.currentTime > 5 && match.duration && (match.currentTime < match.duration - 15)) {
        savedPosition = match.currentTime;
      }
    }

    function showResumeToast(seconds) {
      const toast = document.createElement('div');
      toast.id = 'resumeToast';
      toast.style.cssText = 'position: fixed; top: 80px; left: 50%; transform: translateX(-50%); background: rgba(18, 18, 22, 0.95); border: 1px solid rgba(255, 255, 255, 0.2); padding: 12px 20px; border-radius: 30px; display: flex; align-items: center; gap: 14px; color: #fff; font-size: 0.88rem; z-index: 100; backdrop-filter: blur(10px); box-shadow: 0 10px 25px rgba(0,0,0,0.5);';
      toast.innerHTML = `
        <span>▶ Reprise automatique à <strong>${formatTime(seconds)}</strong></span>
        <button onclick="resetPlaybackToZero()" style="background: rgba(255,255,255,0.15); border: none; color: #fff; padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; cursor: pointer; font-weight: 600;">Recommencer</button>
      `;
      document.body.appendChild(toast);
      setTimeout(() => {
        if (toast.parentNode) toast.remove();
      }, 7000);
    }

    function resetPlaybackToZero() {
      if (videoEl) videoEl.currentTime = 0;
      const toast = document.getElementById('resumeToast');
      if (toast) toast.remove();
    }

    function trackHistory() {
      const now = Date.now();
      if (now - lastHistorySave < 3000) return;
      lastHistorySave = now;
      const cur = videoEl ? videoEl.currentTime : savedPosition;
      const dur = videoEl ? (videoEl.duration || 0) : 0;
      saveWatchHistory({
        id: '<%= id || "" %>',
        type: '<%= type || "movie" %>',
        title: <%- JSON.stringify(titleDisplay || "") %>,
        poster: <%- JSON.stringify(posterUrl || "") %>,
        season: parseInt('<%= season || 1 %>'),
        episode: parseInt('<%= episode || 1 %>'),
        currentTime: cur,
        duration: dur
      });
    }

    let freezeDetectorTimer = null;
    let lastCheckTime = -1;
    let freezeStuckCount = 0;

    function initAntiFreezeGuard(video) {
      if (!video) return;

      const handleBufferStall = () => {
        if (!video || video.paused || video.ended) return;
        if (video.duration && video.currentTime < video.duration - 1) {
          video.currentTime = Math.min(video.duration, video.currentTime + 0.35);
          video.play().catch(() => {});
        }
      };

      video.addEventListener('waiting', handleBufferStall);
      video.addEventListener('stalled', handleBufferStall);
      video.addEventListener('error', handleBufferStall);

      if (freezeDetectorTimer) clearInterval(freezeDetectorTimer);
      freezeDetectorTimer = setInterval(() => {
        if (!video || video.paused || video.ended || video.readyState < 2) {
          lastCheckTime = -1;
          freezeStuckCount = 0;
          return;
        }

        if (lastCheckTime > 0 && Math.abs(video.currentTime - lastCheckTime) < 0.05) {
          freezeStuckCount++;
          if (freezeStuckCount >= 2) {
            freezeStuckCount = 0;
            if (video.duration && video.currentTime < video.duration - 1) {
              video.currentTime = Math.min(video.duration, video.currentTime + 0.4);
              video.play().catch(() => {});
            }
          }
        } else {
          freezeStuckCount = 0;
          lastCheckTime = video.currentTime;
        }
      }, 1200);
    }

    function initPlayer(url, type) {
      const box = document.getElementById('playerBox');
      if (!box || !url) return;

      const overlay = document.getElementById('overlayControls');
      const centerPlay = document.querySelector('.center-play-trigger');
      const bottomBar = document.querySelector('.bottom-bar');
      const backBtn = document.querySelector('.back-btn');
      const rightCtrls = document.querySelector('.right-ctrls');

      if (type === 'video' || url.includes('.mp4') || url.includes('.m3u8')) {
        box.innerHTML = '<video id="videoElement" autoplay playsinline webkit-playsinline style="width: 100%; height: 100%; object-fit: contain;"></video>';
        videoEl = document.getElementById('videoElement');
        const proxyUrl = `/api/proxy/stream?url=${encodeURIComponent(url)}`;

        if (overlay) overlay.style.pointerEvents = 'auto';
        if (centerPlay) centerPlay.style.display = 'flex';
        if (bottomBar) bottomBar.style.display = 'flex';

        if (url.includes('.m3u8') && Hls.isSupported()) {
          const hls = new Hls({
            enableWorker: true,
            lowLatencyMode: false,
            maxBufferLength: 60
          });
          hls.loadSource(proxyUrl);
          hls.attachMedia(videoEl);

          hls.on(Hls.Events.ERROR, (event, data) => {
            if (data.fatal) {
              switch (data.type) {
                case Hls.ErrorTypes.NETWORK_ERROR:
                  hls.startLoad();
                  break;
                case Hls.ErrorTypes.MEDIA_ERROR:
                  hls.recoverMediaError();
                  break;
                default:
                  hls.destroy();
                  break;
              }
            }
          });
        } else {
          videoEl.src = proxyUrl;
        }

        initAntiFreezeGuard(videoEl);

        videoEl.addEventListener('loadedmetadata', () => {
          if (savedPosition > 0) {
            videoEl.currentTime = savedPosition;
            showResumeToast(savedPosition);
          }
        });

        videoEl.addEventListener('timeupdate', updateProgress);
        videoEl.addEventListener('play', updatePlayIcons);
        videoEl.addEventListener('pause', updatePlayIcons);
      } else {
        box.innerHTML = `<iframe id="iframeElement" src="/api/vstream/embed?url=${encodeURIComponent(url)}" allowfullscreen allow="autoplay; fullscreen; encrypted-media" webkitallowfullscreen="true" mozallowfullscreen="true" style="width:100%; height:100%; border:none;"></iframe>`;
        
        if (overlay) overlay.style.pointerEvents = 'none';
        if (centerPlay) centerPlay.style.display = 'none';
        if (bottomBar) bottomBar.style.display = 'none';
        if (backBtn) backBtn.style.pointerEvents = 'auto';
        if (rightCtrls) rightCtrls.style.pointerEvents = 'auto';
      }
    }

    function updateProgress() {
      if (!videoEl) return;
      const cur = videoEl.currentTime;
      const dur = videoEl.duration || 0;
      const pct = (cur / dur) * 100;
      document.getElementById('progressBar').style.width = pct + '%';
      document.getElementById('timeDisplay').textContent = `${formatTime(cur)} / ${formatTime(dur)}`;
      trackHistory();
    }

    function seekVideo(e) {
      if (!videoEl) return;
      const rect = e.currentTarget.getBoundingClientRect();
      const pos = (e.clientX - rect.left) / rect.width;
      videoEl.currentTime = pos * videoEl.duration;
    }

    function togglePlayPause() {
      if (!videoEl) return;
      if (videoEl.paused) videoEl.play();
      else videoEl.pause();
    }

    function updatePlayIcons() {
      if (!videoEl) return;
      const isPaused = videoEl.paused;
      document.getElementById('centerPlayIcon').innerHTML = isPaused ? '<path d="M8 5v14l11-7z"/>' : '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
      document.getElementById('playBtnIcon').innerHTML = isPaused ? '<path d="M8 5v14l11-7z"/>' : '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
    }

    function rewind(s) {
      if (videoEl) videoEl.currentTime -= s;
    }

    function forward(s) {
      if (videoEl) videoEl.currentTime += s;
    }

    function changeVolume(v) {
      if (videoEl) videoEl.volume = v;
    }

    function toggleMute() {
      if (!videoEl) return;
      videoEl.muted = !videoEl.muted;
      document.getElementById('volumeSlider').value = videoEl.muted ? 0 : videoEl.volume;
    }

    function manualUnfreeze() {
      if (videoEl) {
        if (videoEl.duration && videoEl.currentTime < videoEl.duration - 1) {
          videoEl.currentTime = Math.min(videoEl.duration, videoEl.currentTime + 0.4);
        }
        videoEl.play().catch(() => {});
      } else {
        const iframe = document.getElementById('iframeElement');
        if (iframe) {
          iframe.src = iframe.src;
        }
      }
    }

    function switchSourceFromSelect(idx) {
      const src = allSources[idx];
      if (src) initPlayer(src.url, src.type);
    }

    function toggleFullscreen() {
      const root = document.getElementById('playerRoot') || document.documentElement;
      const video = document.getElementById('videoElement');
      const iframe = document.getElementById('iframeElement');

      // Native iOS Safari video element fullscreen support
      if (video && video.webkitEnterFullscreen && (/iPhone|iPad|iPod/i.test(navigator.userAgent) || typeof root.requestFullscreen === 'undefined')) {
        video.webkitEnterFullscreen();
        return;
      }

      const isFs = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;

      if (!isFs) {
        const target = root || iframe || video || document.documentElement;
        if (target.requestFullscreen) {
          target.requestFullscreen().catch(() => {
            if (video && video.webkitEnterFullscreen) video.webkitEnterFullscreen();
          });
        } else if (target.webkitRequestFullscreen) {
          target.webkitRequestFullscreen();
        } else if (target.mozRequestFullScreen) {
          target.mozRequestFullScreen();
        } else if (target.msRequestFullscreen) {
          target.msRequestFullscreen();
        } else if (video && video.webkitEnterFullscreen) {
          video.webkitEnterFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        } else if (document.webkitExitFullscreen) {
          document.webkitExitFullscreen();
        } else if (document.mozCancelFullScreen) {
          document.mozCancelFullScreen();
        } else if (document.msExitFullscreen) {
          document.msExitFullscreen();
        }
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      }
    });

    document.addEventListener('mousemove', () => {
      const overlay = document.getElementById('overlayControls');
      const root = document.getElementById('playerRoot');
      overlay.classList.remove('hide');
      root.classList.remove('hide-cursor');

      clearTimeout(controlsTimeout);
      controlsTimeout = setTimeout(() => {
        if (videoEl && !videoEl.paused) {
          overlay.classList.add('hide');
          root.classList.add('hide-cursor');
        }
      }, 3000);
    });

    document.addEventListener('DOMContentLoaded', () => {
      checkResumePosition();
      trackHistory();
      if (allSources.length > 0) {
        initPlayer(allSources[0].url, allSources[0].type);
      }
    });
  </script>
</body>
</html>
