<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JapoPlay - Séries</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav class="navbar scrolled">
    <div class="nav-left">
      <a href="/home" class="brand-logo">JAPO<span>PLAY</span></a>
      <ul class="nav-links">
        <li><a href="/home">Accueil</a></li>
        <li><a href="/movies">Films</a></li>
        <li><a href="/series" class="active">Séries</a></li>
        <li><a href="/anime">Animes</a></li>
        <li><a href="/iptv">Live TV</a></li>
        <li><a href="/history">Historique</a></li>
        <li><a href="/my-list">Ma Liste</a></li>
      </ul>
    </div>
    <div class="nav-right">
      <form action="/search" method="GET" class="search-box">
        <svg viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" placeholder="Rechercher une série...">
      </form>
      <a href="https://discord.gg/zCQjctTFr" target="_blank" rel="noopener noreferrer" class="discord-btn" title="Rejoindre notre serveur Discord">
        <svg viewBox="0 0 127.14 96.36"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-18.91-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74C48.89,40.23,54,46,53.88,53S48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5.08-12.74,11.44-12.74C91.11,40.23,96.22,46,96.1,53S91.08,65.69,84.69,65.69Z"/></svg>
        <span>Discord</span>
      </a>
      <a href="/profiles" class="current-profile-btn">
        <img id="currentAvatar" src="" alt="Profile">
      </a>
    </div>
  </nav>

  <main style="padding: 100px 4% 40px 4%;">
    <div class="section-header" style="margin-bottom: 30px;">
      <h1 class="section-title" style="font-size: 2rem;">
        Séries TV
      </h1>
      <span class="hero-badge">Page <%= page %> sur <%= totalPages %></span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px;">
      <% series.forEach(item => { %>
        <% if (item.poster_path) { %>
          <a href="/series/<%= item.id %>" class="card-item" style="flex: auto;">
            <img src="https://image.tmdb.org/t/p/w500<%= item.poster_path %>" alt="<%= item.name %>" class="card-poster">
            <div class="card-info">
              <div class="card-title"><%= item.name %></div>
              <div class="card-meta">
                <span><%= item.first_air_date ? item.first_air_date.substring(0,4) : 'SÉRIE' %></span>
                <span class="card-rating">★ <%= item.vote_average ? item.vote_average.toFixed(1) : '8.0' %></span>
              </div>
            </div>
          </a>
        <% } %>
      <% }) %>
    </div>

    <div style="display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 50px;">
      <% if (page > 1) { %>
        <a href="/series?page=<%= page - 1 %>" class="btn-secondary" style="padding: 10px 20px; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          Page Précédente
        </a>
      <% } %>
      <span style="font-weight: 700; color: var(--text-sub);">Page <%= page %> sur <%= totalPages %></span>
      <% if (page < totalPages) { %>
        <a href="/series?page=<%= page + 1 %>" class="btn-primary" style="padding: 10px 20px; display: flex; align-items: center; gap: 8px;">
          Page Suivante
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      <% } %>
    </div>
  </main>

  <script src="/js/app.js"></script>
</body>
</html>
