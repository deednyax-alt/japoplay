<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JapoPlay - Épisodes Anime</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav class="navbar scrolled">
    <div class="nav-left">
      <a href="/home" class="brand-logo">JAPO<span>PLAY</span></a>
      <ul class="nav-links">
        <li><a href="/home">Accueil</a></li>
        <li><a href="/anime" class="active">Animes</a></li>
      </ul>
    </div>
    <div class="nav-right">
      <a href="/profiles" class="current-profile-btn">
        <img id="currentAvatar" src="" alt="Profile">
      </a>
    </div>
  </nav>

  <main style="padding: 100px 4% 40px 4%;">
    <div style="display: flex; gap: 36px; margin-bottom: 40px; flex-wrap: wrap;">
      <img src="<%= details.image %>" style="width: 240px; height: 350px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
      <div style="flex: 1; min-width: 300px;">
        <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 16px;">Saisons & Épisodes Anime</h1>
        <p style="color: var(--text-sub); margin-bottom: 24px;">Choisissez une saison et un épisode pour lancer la lecture direct via nos scrapers.</p>
        
        <% Object.entries(details.seasons).forEach(([seasonName, sData]) => { %>
          <div style="background: var(--bg-card); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 20px; margin-bottom: 20px;">
            <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 14px;"><%= seasonName %></h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;">
              <% sData.episodes.forEach(ep => { %>
                <div style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-light); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
                  <span style="font-weight: 700; font-size: 0.9rem;"><%= ep.name %></span>
                  <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                    <% ep.streaming_links.forEach(link => { %>
                      <% if (link.players && link.players.length > 0) { %>
                        <a href="/watch?type=anime&id=<%= animeId %>&title=<%= encodeURIComponent(ep.name) %>&apiUrl=<%= encodeURIComponent(link.players[0]) %>" class="btn-primary" style="padding: 6px 12px; font-size: 0.78rem;">
                          <%= link.language.toUpperCase() %>
                        </a>
                      <% } %>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>

  <script src="/js/app.js"></script>
</body>
</html>
