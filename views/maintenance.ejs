<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JapoPlay - Site en Maintenance</title>
  <link rel="stylesheet" href="/css/main.css?v=20260810_3">
  <style>
    body {
      background: #09090b;
      color: #ffffff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      margin: 0;
      overflow-x: hidden;
    }

    .maintenance-card {
      background: rgba(18, 18, 24, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 40px 30px;
      max-width: 540px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(16px);
      position: relative;
      overflow: hidden;
    }

    .maintenance-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #e50914, #5865F2, #e50914);
      background-size: 200% 100%;
      animation: gradientMove 3s linear infinite;
    }

    @keyframes gradientMove {
      0% { background-position: 0% 0%; }
      100% { background-position: 200% 0%; }
    }

    .gear-container {
      width: 90px;
      height: 90px;
      margin: 0 auto 20px auto;
      background: rgba(88, 101, 242, 0.12);
      border: 1px solid rgba(88, 101, 242, 0.35);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .gear-icon {
      width: 44px;
      height: 44px;
      animation: spinGear 12s linear infinite;
    }

    @keyframes spinGear {
      100% { transform: rotate(360deg); }
    }

    .m-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(229, 9, 20, 0.15);
      border: 1px solid rgba(229, 9, 20, 0.4);
      color: #ef4444;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      margin-bottom: 16px;
    }

    .m-title {
      font-size: 1.8rem;
      font-weight: 900;
      margin: 0 0 12px 0;
      letter-spacing: -0.5px;
    }

    .m-title span {
      color: #e50914;
    }

    .m-message {
      color: rgba(255, 255, 255, 0.75);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 28px;
    }

    .m-actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: center;
    }

    .footer-admin-link {
      margin-top: 30px;
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.4);
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer-admin-link:hover {
      color: #ffffff;
    }
  </style>
</head>
<body>

  <div class="maintenance-card">
    <div class="gear-container">
      <svg class="gear-icon" viewBox="0 0 24 24" fill="none" stroke="#5865F2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
    </div>

    <div class="m-badge">🛠️ MAINTENANCE EN COURS</div>
    <h1 class="m-title">JAPO<span>PLAY</span> EST EN MAINTENANCE</h1>
    <p class="m-message"><%= message %></p>

    <div class="m-actions">
      <a href="https://discord.gg/zCQjctTFr" target="_blank" rel="noopener noreferrer" class="discord-banner-btn" style="background: #5865F2 !important; color: #ffffff !important; width: 100%; max-width: 320px;">
        <div class="discord-icon-badge" style="background: #ffffff !important; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
          <svg viewBox="0 0 127.14 96.36" style="fill: #5865F2 !important; width: 15px; height: 15px;"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-18.91-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74C48.89,40.23,54,46,53.88,53S48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5.08-12.74,11.44-12.74C91.11,40.23,96.22,46,96.1,53S91.08,65.69,84.69,65.69Z"/></svg>
        </div>
        <span>Rejoindre le Discord pour les Infos</span>
      </a>
    </div>

    <a href="/admin" class="footer-admin-link">🔑 Espace Administrateur</a>
  </div>

</body>
</html>
