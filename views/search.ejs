<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JapoPlay - Recherche : <%= query %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav class="navbar scrolled">
    <div class="nav-left">
      <a href="/home" class="brand-logo">JAPO<span>PLAY</span></a>
      <ul class="nav-links">
        <li><a href="/home">Accueil</a></li>
        <li><a href="/anime">Animes</a></li>
        <li><a href="/iptv">Live TV</a></li>
      </ul>
    </div>
    <div class="nav-right">
      <div class="online-badge" title="Utilisateurs en ligne en temps réel">
        <div class="online-dot"></div>
        <span><strong class="online-count-val">1</strong> en ligne</span>
      </div>
      <form action="/search" method="GET" class="search-box">
        <svg viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" value="<%= query %>" placeholder="Rechercher...">
      </form>
      <a href="https://discord.gg/zCQjctTFr" target="_blank" rel="noopener noreferrer" class="discord-btn" title="Rejoindre notre serveur Discord">
        <svg viewBox="0 0 127.14 96.36"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-18.91-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74C48.89,40.23,54,46,53.88,53S48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5.08-12.74,11.44-12.74C91.11,40.23,96.22,46,96.1,53S91.08,65.69,84.69,65.69Z"/></svg>
        <span>Discord</span>
      </a>
      <a href="/profiles" class="current-profile-btn">
        <img id="currentAvatar" src="" alt="Profile">
      </a>
    </div>
  </nav>

  <main style="padding: 100px 4% 40px 4%;">
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 24px;">Résultats de recherche pour "<%= query %>"</h1>

    <% if (movies.length > 0) { %>
      <h2 class="section-title" style="margin-bottom: 16px;">Films</h2>
      <div class="cards-grid" style="margin-bottom: 40px;">
        <% movies.forEach(item => { %>
          <% if (item.poster_path) { %>
            <a href="/movie/<%= item.id %>" class="card-item">
              <img src="https://image.tmdb.org/t/p/w500<%= item.poster_path %>" class="card-poster">
              <div class="card-info">
                <div class="card-title"><%= item.title %></div>
                <div class="card-meta">
                  <span>📅 <%= item.release_date ? item.release_date.substring(0,4) : 'FILM' %></span>
                  <span class="card-rating">★ <%= item.vote_average ? item.vote_average.toFixed(1) : '8.0' %></span>
                </div>
              </div>
            </a>
          <% } %>
        <% }) %>
      </div>
    <% } %>

    <% if (series.length > 0) { %>
      <h2 class="section-title" style="margin-bottom: 16px;">Séries</h2>
      <div class="cards-grid" style="margin-bottom: 40px;">
        <% series.forEach(item => { %>
          <% if (item.poster_path) { %>
            <a href="/series/<%= item.id %>" class="card-item">
              <img src="https://image.tmdb.org/t/p/w500<%= item.poster_path %>" class="card-poster">
              <div class="card-info">
                <div class="card-title"><%= item.name %></div>
                <div class="card-meta">
                  <span>📅 <%= item.first_air_date ? item.first_air_date.substring(0,4) : 'SÉRIE' %></span>
                  <span class="card-rating">★ <%= item.vote_average ? item.vote_average.toFixed(1) : '8.0' %></span>
                </div>
              </div>
            </a>
          <% } %>
        <% }) %>
      </div>
    <% } %>

    <% if (animes.length > 0) { %>
      <h2 class="section-title" style="margin-bottom: 16px;">Animes</h2>
      <div class="cards-grid" style="margin-bottom: 40px;">
        <% animes.forEach(item => { %>
          <a href="/series/<%= item.id %>" class="card-item">
            <img src="<%= item.poster_path ? ('https://image.tmdb.org/t/p/w500' + item.poster_path) : (item.image || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=300&q=80') %>" class="card-poster">
            <div class="card-info">
              <div class="card-title"><%= item.name || item.title %></div>
              <div class="card-meta">
                <span>📅 <%= (item.first_air_date || item.release_date || item.startDate) ? (item.first_air_date || item.release_date || item.startDate).substring(0,4) : 'ANIME' %></span>
                <span class="card-rating">★ <%= item.vote_average ? item.vote_average.toFixed(1) : '8.0' %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

    <% if (iptv.length > 0) { %>
      <h2 class="section-title" style="margin-bottom: 16px;">TV en Direct (IPTV)</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px;">
        <% iptv.forEach(c => { %>
          <a href="/iptv" class="btn-secondary" style="justify-content: flex-start; gap: 12px; padding: 12px;">
            <img src="<%= c.logo %>" style="width: 36px; height: 24px; object-fit: contain;">
            <span><%= c.name %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>

  <div class="mobile-bottom-nav">
    <a href="/home" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Accueil</span>
    </a>
    <a href="/movies" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>
      <span>Films</span>
    </a>
    <a href="/series" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
      <span>Séries</span>
    </a>
    <a href="/anime" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      <span>Animes</span>
    </a>
    <a href="/iptv" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.83a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/></svg>
      <span>Live TV</span>
    </a>
    <a href="/history" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Historique</span>
    </a>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
