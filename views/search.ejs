<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JapoPlay - Recherche : <%= query %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav class="navbar scrolled">
    <div class="nav-left">
      <a href="/home" class="brand-logo">JAPO<span>PLAY</span></a>
      <ul class="nav-links">
        <li><a href="/home">Accueil</a></li>
        <li><a href="/anime">Animes</a></li>
        <li><a href="/iptv">Live TV</a></li>
      </ul>
    </div>
    <div class="nav-right">
      <form action="/search" method="GET" class="search-box">
        <svg viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" value="<%= query %>" placeholder="Rechercher...">
      </form>
      <a href="/profiles" class="current-profile-btn">
        <img id="currentAvatar" src="" alt="Profile">
      </a>
    </div>
  </nav>

  <main style="padding: 100px 4% 40px 4%;">
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 24px;">Résultats de recherche pour "<%= query %>"</h1>

    <% if (movies.length > 0) { %>
      <h2 class="section-title" style="margin-bottom: 16px;">Films</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; margin-bottom: 40px;">
        <% movies.forEach(item => { %>
          <% if (item.poster_path) { %>
            <a href="/movie/<%= item.id %>" class="card-item" style="flex: auto;">
              <img src="https://image.tmdb.org/t/p/w500<%= item.poster_path %>" class="card-poster">
              <div class="card-info">
                <div class="card-title"><%= item.title %></div>
                <div class="card-meta">
                  <span>FILM</span>
                  <span class="card-rating">★ <%= item.vote_average ? item.vote_average.toFixed(1) : '' %></span>
                </div>
              </div>
            </a>
          <% } %>
        <% }) %>
      </div>
    <% } %>

    <% if (series.length > 0) { %>
      <h2 class="section-title" style="margin-bottom: 16px;">Séries</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; margin-bottom: 40px;">
        <% series.forEach(item => { %>
          <% if (item.poster_path) { %>
            <a href="/series/<%= item.id %>" class="card-item" style="flex: auto;">
              <img src="https://image.tmdb.org/t/p/w500<%= item.poster_path %>" class="card-poster">
              <div class="card-info">
                <div class="card-title"><%= item.name %></div>
                <div class="card-meta">
                  <span>SÉRIE</span>
                  <span class="card-rating">★ <%= item.vote_average ? item.vote_average.toFixed(1) : '' %></span>
                </div>
              </div>
            </a>
          <% } %>
        <% }) %>
      </div>
    <% } %>

    <% if (animes.length > 0) { %>
      <h2 class="section-title" style="margin-bottom: 16px;">Animes (Franime)</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; margin-bottom: 40px;">
        <% animes.forEach(item => { %>
          <a href="/anime/<%= item.id %>" class="card-item" style="flex: auto;">
            <img src="<%= item.image || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=300&q=80' %>" class="card-poster">
            <div class="card-info">
              <div class="card-title"><%= item.name %></div>
              <div class="card-meta">
                <span>ANIME</span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

    <% if (iptv.length > 0) { %>
      <h2 class="section-title" style="margin-bottom: 16px;">TV en Direct (IPTV)</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px;">
        <% iptv.forEach(c => { %>
          <a href="/iptv" class="btn-secondary" style="justify-content: flex-start; gap: 12px; padding: 12px;">
            <img src="<%= c.logo %>" style="width: 36px; height: 24px; object-fit: contain;">
            <span><%= c.name %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>

  <script src="/js/app.js"></script>
</body>
</html>
